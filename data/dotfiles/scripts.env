alias xal-git-push-all-remotes="bash \"$HOME/dotfiles/data/scripts/git-push-all-remotes.sh\""

if [[ "$OSTYPE" == darwin* ]]; then
  alias xal-docker-start="bash \"$HOME/dotfiles/data/scripts/docker-start.macos.sh\""
  alias xal-docker-stop="bash \"$HOME/dotfiles/data/scripts/docker-stop.macos.sh\""
fi
