alias xal-git-push-all-remotes="bash \"$HOME/dotfiles/data/scripts/git-push-all-remotes.sh\""

# Queue heavy cargo commands machine-wide so parallel Rust builds don't eat all RAM.
# Bypass with `command cargo ...`. No-op where flock is missing (macOS).
# ponytail: one global slot; a counting semaphore (N locks) if serial is too slow.
cargo() {
    case "$1" in
        build|b|check|c|clippy|test|t|bench|doc|install) ;;
        *) command cargo "$@"; return ;;  # run/fmt/add/etc stay unlocked
    esac
    if ! command -v flock >/dev/null; then command cargo "$@"; return; fi
    local lock="${XDG_RUNTIME_DIR:-/tmp}/cargo-queue.lock"
    # flock execs the cargo binary, not this function. -E 75 = "lock busy".
    flock -n -E 75 "$lock" cargo "$@"
    local rc=$?
    [ "$rc" -ne 75 ] && return "$rc"
    echo "cargo-queue: waiting for another build..." >&2
    flock "$lock" cargo "$@"
}
